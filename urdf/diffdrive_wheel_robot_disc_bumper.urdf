<?xml version="1.0" ?>
<!--
  Differential Drive Robot URDF (Disc Bumper Variant)

  Changes from diffdrive_wheel_robot.urdf:
  - Removes front sphere bumper.
  - Adds a thin-cylinder ("disc-like") bumper sensor at the front.
  - Bumper disc uses approximately the old main-body radius footprint.
  - Main body is reduced in size so body and bumper are clearly distinct.
-->
<robot name="diffdrive_wheel_robot_disc_bumper">
  <!-- ==================== MATERIALS ==================== -->
  <material name="robot_blue">
    <color rgba="0.2 0.4 0.8 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="dark_gray">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>
  <material name="marker_green">
    <color rgba="0.2 0.8 0.2 1.0"/>
  </material>
  <material name="marker_red">
    <color rgba="0.9 0.2 0.2 1.0"/>
  </material>
  <!-- ==================== WORLD LINK ==================== -->
  <link name="world"/>

  <!-- ==================== PLANAR JOINTS ==================== -->
  <joint name="x_joint" type="prismatic">
    <parent link="world"/>
    <child link="x_carrier"/>
    <origin rpy="0 0 0" xyz="0 0 0.02"/>
    <axis xyz="1 0 0"/>
    <limit effort="1000" lower="-100" upper="100" velocity="10"/>
    <dynamics damping="1.0"/>
  </joint>
  <link name="x_carrier">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="y_joint" type="prismatic">
    <parent link="x_carrier"/>
    <child link="y_carrier"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="1000" lower="-100" upper="100" velocity="10"/>
    <dynamics damping="1.0"/>
  </joint>
  <link name="y_carrier">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="theta_joint" type="continuous">
    <parent link="y_carrier"/>
    <child link="base_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="1000" velocity="20"/>
    <dynamics damping="0.5"/>
  </joint>

  <!-- ==================== MAIN BODY (REDUCED SIZE) ==================== -->
  <link name="base_link">
    <visual>
      <geometry>
        <cylinder length="0.06" radius="0.05"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.02"/>
      <material name="robot_blue"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.06" radius="0.05"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.02"/>
    </collision>
    <inertial>
      <mass value="0.45"/>
      <origin xyz="0 0 0.02"/>
      <inertia ixx="0.00035" ixy="0" ixz="0" iyy="0.00035" iyz="0" izz="0.00060"/>
    </inertial>
  </link>

  <!-- Marker as dedicated link to preserve material/color in PyBullet -->
  <joint name="heading_marker_joint" type="fixed">
    <parent link="base_link"/>
    <child link="heading_marker_link"/>
    <origin rpy="0 0 0" xyz="0.03 0 0.06"/>
  </joint>
  <link name="heading_marker_link">
    <visual>
      <geometry>
        <box size="0.05 0.01 0.008"/>
      </geometry>
      <material name="marker_red"/>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/>
    </inertial>
  </link>

  <!-- ==================== THIN DISC-LIKE BUMPER SENSOR ==================== -->
  <joint name="bumper_joint" type="fixed">
    <parent link="base_link"/>
    <child link="bumper"/>
    <!-- Place disc slightly in front of reduced body -->
    <origin rpy="0 0 0" xyz="0 0 0.058"/>
  </joint>
  <link name="bumper">
    <visual>
      <geometry>
        <!-- "Disc": radius copied from old body footprint (~0.06), thin thickness -->
        <cylinder length="0.01" radius="0.060"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.01" radius="0.060"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.08"/>
      <inertia ixx="0.00008" ixy="0" ixz="0" iyy="0.00008" iyz="0" izz="0.00012"/>
    </inertial>
  </link>

  <!-- ==================== DRIVE WHEELS ==================== -->
  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <origin rpy="-1.5708 0 0" xyz="0 0.05 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" velocity="100"/>
    <dynamics damping="0.01"/>
  </joint>
  <link name="wheel_left_link">
    <visual>
      <geometry>
        <cylinder length="0.01" radius="0.015"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.01" radius="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="5.6e-06" ixy="0" ixz="0" iyy="5.6e-06" iyz="0" izz="1e-05"/>
    </inertial>
  </link>

  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <origin rpy="-1.5708 0 0" xyz="0 -0.05 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" velocity="100"/>
    <dynamics damping="0.01"/>
  </joint>
  <link name="wheel_right_link">
    <visual>
      <geometry>
        <cylinder length="0.01" radius="0.02"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.01" radius="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="5.6e-06" ixy="0" ixz="0" iyy="5.6e-06" iyz="0" izz="1e-05"/>
    </inertial>
  </link>

  <!-- ==================== CASTER WHEEL ==================== -->
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin rpy="0 0 0" xyz="-0.045 0 -0.01"/>
  </joint>
  <link name="caster_link">
    <visual>
      <geometry>
        <sphere radius="0.01"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.01"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
</robot>

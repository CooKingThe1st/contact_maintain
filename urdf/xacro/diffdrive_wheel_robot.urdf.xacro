<?xml version="1.0"?>
<!--
  Differential Drive Robot URDF (Realistic with Wheels)
  
  A non-holonomic robot with 2 drive wheels and a caster wheel.
  Unlike the dummy DifferentialDriveRobot that constrains velocity directly,
  this robot uses actual wheel control and physics.
  
  Kinematics:
  - v = (v_left + v_right) / 2
  - omega = (v_right - v_left) / wheel_base
-->
<robot name="diffdrive_wheel_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================== PARAMETERS ==================== -->
  
  <!-- Robot body dimensions - scaled to realistic small robot (radius ~0.06m) -->
  <xacro:property name="body_radius" value="0.06"/>
  <xacro:property name="body_height" value="0.05"/>
  <xacro:property name="body_mass" value="0.6"/>
  
  <!-- Drive wheel parameters - scaled proportionally -->
  <xacro:property name="wheel_radius" value="0.02"/>
  <xacro:property name="wheel_width" value="0.012"/>
  <xacro:property name="wheel_mass" value="0.05"/>
  <xacro:property name="wheel_base" value="0.10"/>
  
  <!-- Caster wheel -->
  <xacro:property name="caster_radius" value="0.01"/>
  <xacro:property name="caster_offset" value="-0.045"/>
  
  <!-- Bumper parameters -->
  <xacro:property name="bumper_radius" value="0.015"/>
  <xacro:property name="bumper_offset_x" value="0.055"/>
  <xacro:property name="bumper_height" value="0.025"/>
  
  <!-- ==================== MATERIALS ==================== -->
  
  <material name="robot_blue">
    <color rgba="0.2 0.4 0.8 1.0"/>
  </material>
  
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  
  <material name="dark_gray">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>
  
  <material name="marker_red">
    <color rgba="0.9 0.2 0.2 1.0"/>
  </material>

  <!-- ==================== WORLD LINK ==================== -->
  
  <link name="world"/>
  
  <!-- ==================== PLANAR JOINTS ==================== -->
  
  <!-- X translation joint -->
  <joint name="x_joint" type="prismatic">
    <parent link="world"/>
    <child link="x_carrier"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-100" upper="100" effort="1000" velocity="10"/>
    <dynamics damping="1.0"/>
  </joint>
  
  <link name="x_carrier">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  
  <!-- Y translation joint -->
  <joint name="y_joint" type="prismatic">
    <parent link="x_carrier"/>
    <child link="y_carrier"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-100" upper="100" effort="1000" velocity="10"/>
    <dynamics damping="1.0"/>
  </joint>
  
  <link name="y_carrier">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  
  <!-- Theta rotation joint -->
  <joint name="theta_joint" type="continuous">
    <parent link="y_carrier"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="1000" velocity="20"/>
    <dynamics damping="0.5"/>
  </joint>

  <!-- ==================== BASE LINK ==================== -->
  
  <link name="base_link">
    <!-- Main cylindrical body -->
    <visual>
      <geometry>
        <cylinder length="${body_height}" radius="${body_radius}"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 ${body_height/2}"/>
      <material name="robot_blue"/>
    </visual>
    
    <!-- Forward direction marker -->
    <visual>
      <geometry>
        <box size="0.1 0.02 0.01"/>
      </geometry>
      <origin rpy="0 0 0" xyz="${body_radius - 0.05} 0 ${body_height + 0.005}"/>
      <material name="marker_red"/>
    </visual>
    
    <collision>
      <geometry>
        <cylinder length="${body_height}" radius="${body_radius}"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 ${body_height/2}"/>
    </collision>
    
    <inertial>
      <mass value="${body_mass}"/>
      <origin xyz="0 0 ${body_height/2}"/>
      <inertia ixx="${body_mass*(3*body_radius*body_radius + body_height*body_height)/12}"
               ixy="0" ixz="0"
               iyy="${body_mass*(3*body_radius*body_radius + body_height*body_height)/12}"
               iyz="0"
               izz="${body_mass*body_radius*body_radius/2}"/>
    </inertial>
  </link>

  <!-- ==================== BUMPER ==================== -->
  
  <joint name="bumper_joint" type="fixed">
    <parent link="base_link"/>
    <child link="bumper"/>
    <origin xyz="${bumper_offset_x} 0 ${bumper_height}" rpy="0 0 0"/>
  </joint>
  
  <link name="bumper">
    <visual>
      <geometry>
        <sphere radius="${bumper_radius}"/>
      </geometry>
      <material name="black"/>
    </visual>
    
    <collision>
      <geometry>
        <sphere radius="${bumper_radius}"/>
      </geometry>
    </collision>
    
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- ==================== DRIVE WHEELS ==================== -->
  
  <!-- Left wheel -->
  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <origin xyz="0 ${wheel_base/2} 0" rpy="${-1.5708} 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" velocity="100"/>
    <dynamics damping="0.01"/>
  </joint>
  
  <link name="wheel_left_link">
    <visual>
      <geometry>
        <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    
    <collision>
      <geometry>
        <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
      </geometry>
    </collision>
    
    <inertial>
      <mass value="${wheel_mass}"/>
      <inertia ixx="${wheel_mass*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)/12}"
               ixy="0" ixz="0"
               iyy="${wheel_mass*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)/12}"
               iyz="0"
               izz="${wheel_mass*wheel_radius*wheel_radius/2}"/>
    </inertial>
  </link>
  
  <!-- Right wheel -->
  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <origin xyz="0 ${-wheel_base/2} 0" rpy="${-1.5708} 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" velocity="100"/>
    <dynamics damping="0.01"/>
  </joint>
  
  <link name="wheel_right_link">
    <visual>
      <geometry>
        <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    
    <collision>
      <geometry>
        <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
      </geometry>
    </collision>
    
    <inertial>
      <mass value="${wheel_mass}"/>
      <inertia ixx="${wheel_mass*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)/12}"
               ixy="0" ixz="0"
               iyy="${wheel_mass*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)/12}"
               iyz="0"
               izz="${wheel_mass*wheel_radius*wheel_radius/2}"/>
    </inertial>
  </link>

  <!-- ==================== CASTER WHEEL ==================== -->
  
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="${caster_offset} 0 ${caster_radius - wheel_radius}" rpy="0 0 0"/>
  </joint>
  
  <link name="caster_link">
    <visual>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    
    <collision>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

</robot>


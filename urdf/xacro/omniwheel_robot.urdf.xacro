<?xml version="1.0"?>
<!--
  Omniwheel Robot URDF (Minimal Functional Version)
  
  A holonomic robot with 4 omniwheels at 45°, 135°, 225°, 315° from center.
  Uses friction trick: lateral_friction=0 on wheels to simulate omniwheel behavior.
  
  Based on Robotino 3 dimensions with added wheel assemblies.
-->
<robot name="omniwheel_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================== PARAMETERS ==================== -->
  
  <!-- Robot body dimensions - scaled to realistic small robot (radius ~0.06m) -->
  <xacro:property name="body_radius" value="0.06"/>
  <xacro:property name="body_height" value="0.08"/>
  <xacro:property name="body_mass" value="0.8"/>
  
  <!-- Wheel parameters - scaled proportionally -->
  <xacro:property name="wheel_radius" value="0.02"/>
  <xacro:property name="wheel_width" value="0.012"/>
  <xacro:property name="wheel_mass" value="0.05"/>
  <xacro:property name="wheel_distance" value="0.045"/>
  
  <!-- Bumper parameters -->
  <xacro:property name="bumper_radius" value="0.015"/>
  <xacro:property name="bumper_offset_x" value="0.055"/>
  <xacro:property name="bumper_height" value="0.025"/>
  
  <!-- ==================== MATERIALS ==================== -->
  
  <material name="orange">
    <color rgba="1.0 0.4 0.0 1.0"/>
  </material>
  
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  
  <material name="dark_gray">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>
  
  <material name="blue">
    <color rgba="0.0 0.33 1.0 1.0"/>
  </material>

  <!-- ==================== WORLD LINK ==================== -->
  
  <link name="world"/>
  
  <!-- ==================== PLANAR JOINTS (for velocity control) ==================== -->
  
  <!-- X translation joint -->
  <joint name="x_joint" type="prismatic">
    <parent link="world"/>
    <child link="x_carrier"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-100" upper="100" effort="1000" velocity="10"/>
    <dynamics damping="1.0"/>
  </joint>
  
  <link name="x_carrier">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  
  <!-- Y translation joint -->
  <joint name="y_joint" type="prismatic">
    <parent link="x_carrier"/>
    <child link="y_carrier"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-100" upper="100" effort="1000" velocity="10"/>
    <dynamics damping="1.0"/>
  </joint>
  
  <link name="y_carrier">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  
  <!-- Theta rotation joint -->
  <joint name="theta_joint" type="continuous">
    <parent link="y_carrier"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="1000" velocity="20"/>
    <dynamics damping="0.5"/>
  </joint>

  <!-- ==================== BASE LINK ==================== -->
  
  <link name="base_link">
    <!-- Main cylindrical body -->
    <visual>
      <geometry>
        <cylinder length="${body_height}" radius="${body_radius}"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 ${body_height/2}"/>
      <material name="orange"/>
    </visual>
    
    <!-- Top marker ring -->
    <visual>
      <geometry>
        <cylinder length="0.006" radius="${body_radius + 0.003}"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 ${body_height + 0.003}"/>
      <material name="blue"/>
    </visual>
    
    <collision>
      <geometry>
        <cylinder length="${body_height}" radius="${body_radius}"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 ${body_height/2}"/>
    </collision>
    
    <inertial>
      <mass value="${body_mass}"/>
      <origin xyz="0 0 ${body_height/2}"/>
      <!-- Cylinder inertia: Ixx=Iyy=m(3r^2+h^2)/12, Izz=mr^2/2 -->
      <inertia ixx="${body_mass*(3*body_radius*body_radius + body_height*body_height)/12}"
               ixy="0" ixz="0"
               iyy="${body_mass*(3*body_radius*body_radius + body_height*body_height)/12}"
               iyz="0"
               izz="${body_mass*body_radius*body_radius/2}"/>
    </inertial>
  </link>

  <!-- ==================== BUMPER ==================== -->
  
  <joint name="bumper_joint" type="fixed">
    <parent link="base_link"/>
    <child link="bumper"/>
    <origin xyz="${bumper_offset_x} 0 ${bumper_height}" rpy="0 0 0"/>
  </joint>
  
  <link name="bumper">
    <visual>
      <geometry>
        <sphere radius="${bumper_radius}"/>
      </geometry>
      <material name="black"/>
    </visual>
    
    <collision>
      <geometry>
        <sphere radius="${bumper_radius}"/>
      </geometry>
    </collision>
    
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- ==================== WHEEL MACRO ==================== -->
  
  <xacro:macro name="wheel" params="name x y angle">
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} 0" rpy="${-1.5708} 0 ${angle}"/>
      <axis xyz="0 0 1"/>
      <limit effort="100" velocity="100"/>
      <dynamics damping="0.01"/>
    </joint>
    
    <link name="${name}_link">
      <visual>
        <geometry>
          <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
        </geometry>
        <material name="dark_gray"/>
      </visual>
      
      <collision>
        <geometry>
          <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
        </geometry>
      </collision>
      
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${wheel_mass*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)/12}"
                 ixy="0" ixz="0"
                 iyy="${wheel_mass*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)/12}"
                 iyz="0"
                 izz="${wheel_mass*wheel_radius*wheel_radius/2}"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- ==================== WHEEL INSTANCES ==================== -->
  <!-- Wheels at 45°, 135°, 225°, 315° from center -->
  
  <!-- Front-Right wheel (45°) -->
  <xacro:wheel name="wheel_fr" 
               x="${wheel_distance * 0.707}" 
               y="${-wheel_distance * 0.707}" 
               angle="${0.785398}"/>
  
  <!-- Front-Left wheel (135°) -->
  <xacro:wheel name="wheel_fl" 
               x="${wheel_distance * 0.707}" 
               y="${wheel_distance * 0.707}" 
               angle="${2.356194}"/>
  
  <!-- Rear-Left wheel (225°) -->
  <xacro:wheel name="wheel_rl" 
               x="${-wheel_distance * 0.707}" 
               y="${wheel_distance * 0.707}" 
               angle="${3.926991}"/>
  
  <!-- Rear-Right wheel (315°) -->
  <xacro:wheel name="wheel_rr" 
               x="${-wheel_distance * 0.707}" 
               y="${-wheel_distance * 0.707}" 
               angle="${5.497787}"/>

</robot>


<!--
  Differential Drive Robot URDF (Realistic with Wheels)
  
  A non-holonomic robot with 2 drive wheels and a caster wheel.
  Unlike the dummy DifferentialDriveRobot that constrains velocity directly,
  this robot uses actual wheel control and physics.
  
  Kinematics:
  - v = (v_left + v_right) / 2
  - omega = (v_right - v_left) / wheel_base
-->
<robot name="diffdrive_wheel_robot">
  <!-- ==================== PARAMETERS ==================== -->
  <!-- ==================== MATERIALS ==================== -->
  <material name="robot_blue">
    <color rgba="0.2 0.4 0.8 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="dark_gray">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>
  <material name="marker_red">
    <color rgba="0.9 0.2 0.2 1.0"/>
  </material>
  <!-- ==================== WORLD LINK ==================== -->
  <link name="world"/>
  <!-- ==================== PLANAR JOINTS ==================== -->
  <!-- X translation joint -->
  <joint name="x_joint" type="prismatic">
    <parent link="world"/>
    <child link="x_carrier"/>
    <origin rpy="0 0 0" xyz="0 0 0.02"/>
    <axis xyz="1 0 0"/>
    <limit effort="1000" lower="-100" upper="100" velocity="10"/>
    <dynamics damping="1.0"/>
  </joint>
  <link name="x_carrier">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <!-- Y translation joint -->
  <joint name="y_joint" type="prismatic">
    <parent link="x_carrier"/>
    <child link="y_carrier"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="1000" lower="-100" upper="100" velocity="10"/>
    <dynamics damping="1.0"/>
  </joint>
  <link name="y_carrier">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <!-- Theta rotation joint -->
  <joint name="theta_joint" type="continuous">
    <parent link="y_carrier"/>
    <child link="base_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="1000" velocity="20"/>
    <dynamics damping="0.5"/>
  </joint>
  <!-- ==================== BASE LINK ==================== -->
  <link name="base_link">
    <!-- Main cylindrical body -->
    <visual>
      <geometry>
        <cylinder length="0.05" radius="0.06"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.025"/>
      <material name="robot_blue"/>
    </visual>
    <!-- Forward direction marker -->
    <visual>
      <geometry>
        <box size="0.1 0.02 0.01"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0.009999999999999995 0 0.055"/>
      <material name="marker_red"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.05" radius="0.06"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.025"/>
    </collision>
    <inertial>
      <mass value="0.6"/>
      <origin xyz="0 0 0.025"/>
      <inertia ixx="0.0006649999999999999" ixy="0" ixz="0" iyy="0.0006649999999999999" iyz="0" izz="0.0010799999999999998"/>
    </inertial>
  </link>
  <!-- ==================== BUMPER ==================== -->
  <joint name="bumper_joint" type="fixed">
    <parent link="base_link"/>
    <child link="bumper"/>
    <origin rpy="0 0 0" xyz="0.055 0 0.025"/>
  </joint>
  <link name="bumper">
    <visual>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <!-- ==================== DRIVE WHEELS ==================== -->
  <!-- Left wheel -->
  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <origin rpy="-1.5708 0 0" xyz="0 0.05 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" velocity="100"/>
    <dynamics damping="0.01"/>
  </joint>
  <link name="wheel_left_link">
    <visual>
      <geometry>
        <cylinder length="0.012" radius="0.02"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.012" radius="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="5.6e-06" ixy="0" ixz="0" iyy="5.6e-06" iyz="0" izz="1e-05"/>
    </inertial>
  </link>
  <!-- Right wheel -->
  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <origin rpy="-1.5708 0 0" xyz="0 -0.05 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" velocity="100"/>
    <dynamics damping="0.01"/>
  </joint>
  <link name="wheel_right_link">
    <visual>
      <geometry>
        <cylinder length="0.012" radius="0.02"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.012" radius="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="5.6e-06" ixy="0" ixz="0" iyy="5.6e-06" iyz="0" izz="1e-05"/>
    </inertial>
  </link>
  <!-- ==================== CASTER WHEEL ==================== -->
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin rpy="0 0 0" xyz="-0.045 0 -0.01"/>
  </joint>
  <link name="caster_link">
    <visual>
      <geometry>
        <sphere radius="0.01"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.01"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
</robot>


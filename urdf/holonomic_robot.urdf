<robot name="robotino3">
  <!-- 
    Robotino 3 Simplified Model for Contact Maintenance
    
    Based on Festo Robotino 3 from Webots.
    - Cylindrical body (no wheel physics, pure velocity control)
    - Sphere contact sensor ("bumper") at front
    - 3 DOF: x, y translation and rotation around z
    -->
  <!-- Colors matching Robotino -->
  <material name="robotino_orange">
    <color rgba="1.0 0.4 0.0 1.0"/>
  </material>
  <material name="bumper_black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="marker_blue">
    <color rgba="0.0 0.33 1.0 1.0"/>
  </material>
  <!-- World link (fixed reference) -->
  <link name="world"/>
  <!-- X-axis prismatic joint carrier -->
  <link name="x_carrier">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="x_joint" type="prismatic">
    <parent link="world"/>
    <child link="x_carrier"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="1000" lower="-100" upper="100" velocity="10"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>
  <!-- Y-axis prismatic joint carrier -->
  <link name="y_carrier">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="y_joint" type="prismatic">
    <parent link="x_carrier"/>
    <child link="y_carrier"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="1000" lower="-100" upper="100" velocity="10"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>
  <!-- Rotation joint carrier -->
  <link name="theta_carrier">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="theta_joint" type="continuous">
    <parent link="y_carrier"/>
    <child link="theta_carrier"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="1000" velocity="10"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>
  <!-- Robot body (Robotino cylindrical base) -->
  <link name="base_link">
    <!-- Main cylinder body -->
    <visual>
      <geometry>
        <cylinder length="0.08" radius="0.06"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.04"/>
      <material name="robotino_orange"/>
    </visual>
    <!-- Blue ring marker on top (like Webots OUT_CIRCLE) -->
    <visual>
      <geometry>
        <cylinder length="0.006" radius="0.060719999999999996"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.083"/>
      <material name="marker_blue"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.08" radius="0.06"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.04"/>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <origin rpy="0 0 0" xyz="0 0 0.04"/>
      <!-- Cylinder inertia: Ixx=Iyy=m*(3r^2+h^2)/12, Izz=m*r^2/2 -->
      <inertia ixx="0.0007166666666666667" ixy="0" ixz="0" iyy="0.0007166666666666667" iyz="0" izz="0.0009"/>
    </inertial>
  </link>
  <joint name="base_joint" type="fixed">
    <parent link="theta_carrier"/>
    <child link="base_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <!-- Bumper / Contact sensor (sphere at front of robot) -->
  <!-- In Webots: translation -6.6e-06 0.19998 0.08, so roughly at y=0.2, z=0.08 -->
  <!-- After rotation -90deg around z, this becomes x=0.2 in robot frame -->
  <link name="bumper">
    <visual>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
      <material name="bumper_black"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.005"/>
      <!-- Sphere inertia: I = 2/5 * m * r^2 -->
      <inertia ixx="4.5e-07" ixy="0" ixz="0" iyy="4.5e-07" iyz="0" izz="4.5e-07"/>
    </inertial>
  </link>
  <!-- Bumper is at the front edge of the robot body -->
  <joint name="bumper_joint" type="fixed">
    <parent link="base_link"/>
    <child link="bumper"/>
    <!-- Position: front of robot (x = body_radius + small gap), at mid-height -->
    <origin rpy="0 0 0" xyz="0.055 0 0.027999999999999997"/>
  </joint>
</robot>


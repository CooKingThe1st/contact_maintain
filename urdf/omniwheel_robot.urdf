      <geometry>
        <cylinder length="0.012" radius="0.02"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.012" radius="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="5.6e-06" ixy="0" ixz="0" iyy="5.6e-06" iyz="0" izz="1e-05"/>
    </inertial>
  </link>
  <joint name="wheel_fl_joint" type="continuous">

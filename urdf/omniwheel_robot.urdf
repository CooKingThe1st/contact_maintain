<!--
  Omniwheel Robot URDF (Minimal Functional Version)
  
  A holonomic robot with 4 omniwheels at 45°, 135°, 225°, 315° from center.
  Uses friction trick: lateral_friction=0 on wheels to simulate omniwheel behavior.
  
  Based on Robotino 3 dimensions with added wheel assemblies.
-->
<robot name="omniwheel_robot">
  <!-- ==================== PARAMETERS ==================== -->
  <!-- ==================== MATERIALS ==================== -->
  <material name="orange">
    <color rgba="1.0 0.4 0.0 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="dark_gray">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.0 0.33 1.0 1.0"/>
  </material>
  <!-- ==================== WORLD LINK ==================== -->
  <link name="world"/>
  <!-- ==================== PLANAR JOINTS (for velocity control) ==================== -->
  <!-- X translation joint -->
  <joint name="x_joint" type="prismatic">
    <parent link="world"/>
    <child link="x_carrier"/>
    <origin rpy="0 0 0" xyz="0 0 0.02"/>
    <axis xyz="1 0 0"/>
    <limit effort="1000" lower="-100" upper="100" velocity="10"/>
    <dynamics damping="1.0"/>
  </joint>
  <link name="x_carrier">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <!-- Y translation joint -->
  <joint name="y_joint" type="prismatic">
    <parent link="x_carrier"/>
    <child link="y_carrier"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="1000" lower="-100" upper="100" velocity="10"/>
    <dynamics damping="1.0"/>
  </joint>
  <link name="y_carrier">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <!-- Theta rotation joint -->
  <joint name="theta_joint" type="continuous">
    <parent link="y_carrier"/>
    <child link="base_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="1000" velocity="20"/>
    <dynamics damping="0.5"/>
  </joint>
  <!-- ==================== BASE LINK ==================== -->
  <link name="base_link">
    <!-- Main cylindrical body -->
    <visual>
      <geometry>
        <cylinder length="0.08" radius="0.06"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.04"/>
      <material name="orange"/>
    </visual>
    <!-- Top marker ring -->
    <visual>
      <geometry>
        <cylinder length="0.006" radius="0.063"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.083"/>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.08" radius="0.06"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.04"/>
    </collision>
    <inertial>
      <mass value="0.8"/>
      <origin xyz="0 0 0.04"/>
      <!-- Cylinder inertia: Ixx=Iyy=m(3r^2+h^2)/12, Izz=mr^2/2 -->
      <inertia ixx="0.0011466666666666667" ixy="0" ixz="0" iyy="0.0011466666666666667" iyz="0" izz="0.0014399999999999999"/>
    </inertial>
  </link>
  <!-- ==================== BUMPER ==================== -->
  <joint name="bumper_joint" type="fixed">
    <parent link="base_link"/>
    <child link="bumper"/>
    <origin rpy="0 0 0" xyz="0.055 0 0.025"/>
  </joint>
  <link name="bumper">
    <visual>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <!-- ==================== WHEEL MACRO ==================== -->
  <!-- ==================== WHEEL INSTANCES ==================== -->
  <!-- Wheels at 45°, 135°, 225°, 315° from center -->
  <joint name="wheel_fr_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_fr_link"/>
    <origin rpy="-1.5708 0 0.785398" xyz="0.031814999999999996 -0.031814999999999996 0"/>

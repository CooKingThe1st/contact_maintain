      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="5.6e-06" ixy="0" ixz="0" iyy="5.6e-06" iyz="0" izz="1e-05"/>
    </inertial>
  </link>
  <joint name="wheel_rl_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rl_link"/>
    <origin rpy="-1.5708 0 3.926991" xyz="-0.031814999999999996 0.031814999999999996 0"/>
